# VM 部署設定範本。
#
# 使用方式：VM 完成 docs/VM_DEPLOYMENT_STEPS.md 的 Phase 0 現況蒐集後，
# 複製這個檔案成 deploy/deploy.env 並填入實際值：
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env 不會被 commit（見 .gitignore），只存在於 VM 上。
# scripts/*.sh 都會讀這個檔案，不要把值寫死在 script 裡。

# Git repository 在 VM 上的實際路徑
PROJECT_DIR=/opt/taoyuan-air

# 部署觀察的 branch
DEPLOY_BRANCH=main

# Backend / frontend 實際監聽的 port（用 ss -lntp 確認）
BACKEND_PORT=8001
FRONTEND_PORT=3000

# 對外網址，用來跑 public health check
PUBLIC_BASE_URL=https://ncu.edu.tw/tyair

# Process manager：systemd 或 pm2，只能擇一（見 docs/VM_DEPLOYMENT_STEPS.md Phase 0 與 Phase 3）
PROCESS_MANAGER=systemd

# 若 PROCESS_MANAGER=systemd，填實際 unit 名稱
SYSTEMD_BACKEND_SERVICE=taoyuan-air-backend.service
SYSTEMD_FRONTEND_SERVICE=taoyuan-air-frontend.service

# 若 PROCESS_MANAGER=pm2，填實際 process 名稱
PM2_BACKEND_NAME=taoyuan-air-backend
PM2_FRONTEND_NAME=taoyuan-air-frontend

# Log / metadata 路徑（第一次部署前，用 install -d 建立好，見部署文件 Phase 5.1）
DEPLOY_LOG_DIR=/var/log/taoyuan-air
DEPLOY_STATE_DIR=/var/lib/taoyuan-air
