DATABASE_URL=postgresql+asyncpg://你的USER:你的PASSWORD@localhost:5432/taoyuan_air
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000

# Cookie 設定：本機 http 開發用預設值，Production 請用 backend/.env.production.example
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/

NAQO_SUPABASE_URL=https://ohofnntxmncifmssbmpt.supabase.co
NAQO_SUPABASE_ANON_KEY=your_naqo_supabase_anon_key
NAQO_SUPABASE_TABLE=min60
NAQO_DEFAULT_DATA_TYPE=min60
NAQO_TZ_WORKAROUND=true

# 歷史 PM2.5 地圖：需先以 ML CLI 建立該 run 的 history-map --catalog
ML_HISTORY_RUN_ID=full-history-20261113-v1
# 選填絕對路徑；預設使用專案 ml/.venv 的 Python 與 data 目錄。
