# 範本檔案。把環保局 SFTP 上傳的 CSV 從收件區搬到專案的 data/raw/tydep-stations/realtime/。
#
# 安裝（詳見 HackMD「環保局資料傳輸設定」步驟 6）：
#   1. sudo cp ~/tyair/auto_move_watcher.sh /usr/local/bin/auto_move_watcher_tydep.sh
#      並修改使用者設定區：
#        SRC_DIR="/data/sftp_tydep/upload"
#        DEST_DIR="__PROJECT_DIR__/data/raw/tydep-stations/realtime"
#        LOG_FILE="/var/log/auto_move_watcher_tydep.log"
#        CHOWN_TARGET="__DEPLOY_USER__:__DEPLOY_USER__"
#   2. 本檔取代 __PLACEHOLDER__ 後存成 /etc/systemd/system/auto-move-tydep.service
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now auto-move-tydep
#
# 腳本放在 /usr/local/bin 而非家目錄，避免 SELinux 擋住 systemd 執行。
[Unit]
Description=TYDEP SFTP auto move watcher
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/auto_move_watcher_tydep.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
