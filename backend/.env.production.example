# Production env template for the VM — 這個檔案本身只是範本，不含真實密鑰。
# 實際的 backend/.env 只能放在 VM，不要 commit 到 Git。
#
# COOKIE_PATH 是否要設成 /tyair，取決於 Nginx / NCU 是否 preserve /tyair 這個 path，
# 必須以 VM 實測結果為準（見 docs/VM_DEPLOYMENT_STEPS.md）。這裡先給兩種常見值，
# 依實測結果二選一，不要同時保留。

DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/taoyuan_air
SECRET_KEY=<至少 64 字元的隨機字串，用 openssl rand -hex 32 產生>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=https://ncu.edu.tw

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 若 Nginx/Next 保留 /tyair 前綴（推薦方向）：
COOKIE_PATH=/tyair
# 若 Nginx 在轉發前就把 /tyair strip 掉，改用：
# COOKIE_PATH=/
