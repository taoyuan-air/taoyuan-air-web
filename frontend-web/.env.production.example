# Production env template for the VM — 這個檔案本身只是範本，不含真實密鑰。
# 實際的 frontend-web/.env.production 只能放在 VM，不要 commit 到 Git。
#
# basePath / API base 的正確值取決於 Nginx / NCU 是否 preserve /tyair，
# 必須以 VM 實測結果為準（見 docs/VM_DEPLOYMENT_STEPS.md）。

# Next.js basePath / assetPrefix（建置時讀取，需在 npm run build 前設定好）
NEXT_PUBLIC_BASE_PATH=/tyair
NEXT_PUBLIC_API_BASE=/tyair/api

# Next.js rewrite 要打到的 backend 位址（如果 backend 實際 port 不是 8001，改這裡）
BACKEND_ORIGIN=http://127.0.0.1:8001

# 可公開到瀏覽器的 key
NEXT_PUBLIC_WINDY_API_KEY=your_windy_api_key_here
NEXT_PUBLIC_TGOS_API_KEY=your_tgos_api_key_here

# 只在 server-side API route 使用，不會進到瀏覽器 bundle
CWA_API_KEY=your_cwa_api_key_here
MOE_API_KEY=your_moe_api_key_here
